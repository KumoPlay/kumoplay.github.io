---
/**
 * Small decorative icons, drawn with rounded strokes to match the brand.
 * They are hidden from screen readers; the text next to them says what they mean.
 */
interface Props {
  name: 'clock' | 'calendar' | 'play' | 'arrow-left' | 'code';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect x="3.5" y="5" width="17" height="15.5" rx="3.5" />
        <path d="M8 3v4M16 3v4M3.5 10h17" />
      </>
    )
  }
  {name === 'play' && <path d="M8 5.5v13a1 1 0 0 0 1.5.9l10.4-6.5a1 1 0 0 0 0-1.8L9.5 4.6A1 1 0 0 0 8 5.5Z" fill="currentColor" />}
  {name === 'arrow-left' && <path d="M19 12H5m6-6-6 6 6 6" />}
  {name === 'code' && <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-12-2 14" />}
</svg>

---
/**
 * A row of game cards. Swipe sideways on phones; wraps into a grid on wide screens.
 */
import type { Lang } from '../i18n';
import type { Game } from '../lib/games';
import GameCard from './GameCard.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  games: Game[];
  lang: Lang;
  eager?: boolean;
}

const { id, title, intro, games, lang, eager = false } = Astro.props;
---

<section class="section" aria-labelledby={id}>
  <div class="container section-head">
    <h2 id={id}>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <ul class="game-row" role="list">
    {
      games.map((game) => (
        <li>
          <GameCard game={game} lang={lang} eager={eager} />
        </li>
      ))
    }
  </ul>
</section>

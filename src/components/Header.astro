---
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homePath = localizePath('/', lang);
const aboutPath = localizePath('/about/', lang);
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homePath}>
      <picture>
        <source srcset="/brand/kumoplay-icon-dark-bg.svg" media="(prefers-color-scheme: dark)" />
        <img src="/brand/kumoplay-icon.svg" alt="" width="44" height="32" />
      </picture>
      <span>{t('site.name')}</span>
    </a>
    <nav class="site-nav" aria-label={t('nav.label')}>
      <ul>
        <li>
          <a href={homePath} aria-current={current === homePath ? 'page' : undefined}>{t('nav.games')}</a>
        </li>
        <li>
          <a href={aboutPath} aria-current={current === aboutPath ? 'page' : undefined}>{t('nav.about')}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
